# Server Configuration
PORT=3001
NODE_ENV=production

# CORS and Origin (comma-separated for multiple origins)
CORS_ORIGINS=https://your-client-app.railway.app
ORIGIN=https://your-client-app.railway.app

# WebAuthn Configuration (RP_ID should be your domain without protocol)
RP_ID=your-client-app.railway.app

# Twilio Configuration (optional - for phone/SMS features)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_API_KEY=your_api_key
TWILIO_API_SECRET=your_api_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid
